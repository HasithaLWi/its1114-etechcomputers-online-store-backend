# ============================================================
#  application-local.properties — Local Development Secrets
# ============================================================
#  INSTRUCTIONS:
#  1. Copy this file and rename it to: application-local.properties
#  2. Set your local database credentials & Google App Password below
#  3. This file is added to .gitignore and will NEVER be committed to Git!
# ============================================================

# Local Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/etech_online_store?autoReconnect=true&createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=your_local_mysql_password

# Google Mail App Password (16 characters)
spring.mail.password=your_16_character_google_app_password_here

# (Optional environment overrides):
# spring.mail.username=eteccomputers38@gmail.com
