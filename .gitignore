# Documentation & Scratch Plans
HELP.md
implementation_plan.md

# -------------------------------------------------------------------------
# Build & Compiled Output (Maven / Gradle / Java)
# -------------------------------------------------------------------------
target/
build/
out/
bin/
dist/
test/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Ensure test/main resources are not accidentally ignored if named target/build
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Maven Wrapper & Timings
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
.mvn/wrapper/.maven/

